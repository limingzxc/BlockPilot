{
  "name": "blockpilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI-drivable Minecraft launcher core — reference implementation",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "e2e": "tsx scripts/e2e.ts",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "preflight": "tsx src/cli/index.ts preflight",
    "mcp": "tsx src/mcp/server.ts",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "smoke:entry": "node scripts/entry-smoke.mjs",
    "smoke:bin": "node scripts/bin-smoke.mjs",
    "smoke:auth": "tsx scripts/auth-shape-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "smol-toml": "^1.9.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "blockpilot": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
