{
  "name": "blockpilot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AI-drivable Minecraft launcher core — reference implementation",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "e2e": "tsx scripts/e2e.ts",
    "preflight": "tsx src/cli/index.ts preflight",
    "mcp": "tsx src/mcp/server.ts",
    "smoke": "tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "smol-toml": "^1.9.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "blockpilot": "dist/cli/index.js"
  }
}
